# Copy to .env and adjust. Every variable is optional in Phase 0 -- the defaults
# below are what the code already uses, listed here for discoverability.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows cmd)

# --- Runtime -----------------------------------------------------------------
ENGINE_ENVIRONMENT=local
ENGINE_LOG_LEVEL=INFO
# console = human-readable (dev), json = machine-parseable (production)
ENGINE_LOG_FORMAT=console

# --- Storage -----------------------------------------------------------------
# SQLite for local development. The schema is Postgres-compatible, so moving to
# a hosted database is a URL change and nothing else:
#   ENGINE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/engine
ENGINE_DATABASE_URL=sqlite+pysqlite:///./data/engine.db

# --- Paths -------------------------------------------------------------------
ENGINE_CONFIG_DIR=config
# Domain packs: the subject knowledge the engine itself does not have.
ENGINE_PACKS_DIR=packs
ENGINE_DATA_DIR=data
ENGINE_OUTPUT_DIR=output

# --- Tenancy -----------------------------------------------------------------
# Single-tenant today, multi-tenant-ready. This selects the active workspace.
ENGINE_DEFAULT_WORKSPACE_SLUG=default

# --- Ingestion (Phase 1) -----------------------------------------------------
# Google OAuth client you downloaded from Google Cloud Console (Desktop app).
# Identifies the APPLICATION. You create this file manually. Never commit it.
ENGINE_GOOGLE_CREDENTIALS_FILE=credentials.json
# Cached user tokens, written by `engine sources auth`. Identifies YOU.
# Created by the code, not by you. Delete it to force re-consent. Never commit it.
ENGINE_GOOGLE_TOKEN_FILE=token.json

# Per-source ceiling on documents fetched per run.
ENGINE_INGEST_MAX_DOCUMENTS=50
# How far back each run looks. Survives a few days of downtime unattended.
ENGINE_INGEST_LOOKBACK_DAYS=7
# Keep verbatim payloads on disk for replay, parser fixtures and provenance.
ENGINE_INGEST_ARCHIVE_RAW=true

ENGINE_HTTP_TIMEOUT_SECONDS=30
# ENGINE_HTTP_USER_AGENT=ai-media-engine/0.1 (+https://your-repo-url)

# --- LLM (Phase 3 -- not used yet) -------------------------------------------
# ENGINE_ANTHROPIC_API_KEY=sk-ant-...
ENGINE_GENERATION_MODEL=claude-opus-5
ENGINE_EXTRACTION_MODEL=claude-haiku-4-5
